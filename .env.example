# Foundry / contract deployment only.
#
# Copy to `.env` (gitignored) and fill in. `forge` reads this file from the
# REPO ROOT — variables for the Next.js app live in web/.env, not here.
#
# Deploy with:
#   forge script script/DeployPool.s.sol:DeployPool \
#     --rpc-url $SEPOLIA_RPC_URL --private-key $PRIVATE_KEY --broadcast --verify -vvvv

# --- Deployer ---------------------------------------------------------------

# Deployer wallet. Passed via --private-key on the command line (the script
# calls vm.startBroadcast() with no argument, so it uses whatever wallet the
# CLI supplies). Needs Sepolia ETH for gas.
PRIVATE_KEY=

# Sepolia RPC endpoint, passed via --rpc-url.
SEPOLIA_RPC_URL=

# Optional: only needed for the --verify flag (contract source verification).
ETHERSCAN_API_KEY=

# --- Registry constructor arguments -----------------------------------------

# PUBLIC ADDRESS of the backend key that signs liveness attestations. Must be
# the address derived from ATTESTER_PRIVATE_KEY in web/.env — the deploy script
# cross-checks this. Generate the pair with `cast wallet new`.
#
# A mismatch means every attestation fails signature recovery and nobody is ever
# discounted. Recoverable with LivenessOracle.setTrustedSigner, owner only.
TRUSTED_SIGNER=

# Owner of LivenessOracle and Registry: rotates the trusted signer, sets the
# hook, and changes the swap cap. Set this to the deployer address unless you
# have a reason not to — the deploy script can only wire registry.setHook()
# automatically when owner == deployer.
CONTRACTS_OWNER=

# Discounted swaps allowed per attestation, before the user must verify again.
# 0 means uncapped (expiry alone bounds the discount). Both limits must hold:
# a swap is discounted while it is within validUntil AND under this cap.
MAX_SWAPS=10

# --- Pool pair --------------------------------------------------------------

# The two ERC-20s the pool trades. Deploy them first with
#   forge script script/DeployTestTokens.s.sol:DeployTestTokens \
#     --rpc-url $SEPOLIA_RPC_URL --private-key $PRIVATE_KEY --broadcast
# and paste the addresses it prints. DeployPool sorts them itself, so the order
# of these two lines doesn't matter.
TOKEN_USDC=
TOKEN_WBTC=

# --- Deployed addresses -----------------------------------------------------
#
# Printed by DeployPool. Needed by script/seed-traffic.sh, which cannot read
# web/.env's NEXT_PUBLIC_* copies. Re-deploying changes all four — the hook
# address is part of the PoolKey, so a stale value addresses a pool that was
# never initialized and every seeded swap reverts.

PROOFPOOL_HOOK=
PROOFPOOL_ROUTER=
PROOFPOOL_REGISTRY=
PROOFPOOL_ORACLE=

# --- Demo traffic seeding ---------------------------------------------------
#
# All optional; the defaults shown are what the scripts use. See
# script/seed-traffic.sh. The traffic is synthetic and must be described that
# way in the demo — see README.md.

# How many wallets the archetypes are spread across. Minimum 12, so each
# archetype gets at least one wallet. More wallets means more Sepolia ETH:
# every one is a separate EOA, because the hook prices msg.sender at the router.
# SEED_WALLET_COUNT=24

# Gas given to each seed wallet, in wei, sent from PRIVATE_KEY. Leave unset:
# seed-traffic.sh derives it from a dry pass over the real dispatch, priced at
# the live gas price. Set it only to override that.
# SEED_ETH_PER_WALLET=

# Headroom multiplier on the derived funding figure. Gas prices move during a
# run, and a wallet that runs dry leaves a lopsided history rather than an
# obvious failure. Unspent ETH stays in the seed wallets.
# SEED_SAFETY_FACTOR=3

# Seconds between the gas transfers in the funding loop. Defaults to 2, or 5
# under --gentle.
# SEED_FUND_DELAY=

# Separate RPC endpoint for seeding. Seeding is by far the heaviest RPC consumer
# here — a few thousand requests in half an hour — so a second free-tier key
# keeps it off the quota the live demo depends on. Falls back to
# SEPOLIA_RPC_URL.
#
# Rate limits matter more than monthly quotas: a tick broadcasts ~10-25
# transactions at once, which needs roughly 15 req/s. Below that, run with
# --gentle (slower, ~1 req/s). Alchemy and Chainstack free tiers have the
# headroom; a 5 req/s endpoint does not.
SEED_RPC_URL=
# Epoch length for seeded attestations, in seconds. Production uses
# ATTESTATION_TTL_SECONDS (3600). Seeding uses something short so a run lasting
# minutes still contains several verification cycles: one wallet gets one
# attestation per epoch, exactly as the backend issues, so at 3600 the verified
# side of the history would barely move. Match ATTESTATION_TTL_SECONDS to this
# while seeding if you want the web app to behave consistently.
# SEED_EPOCH_SECONDS=120

# How many discounted swaps a burner/overlapper spends in one go. Capped at
# Registry.maxSwaps. These archetypes dominate the cost of a run, so this is the
# cheapest lever on total spend after the tick count.
# SEED_BURN_CAP=4

# Base swap size per token, in that token's own base units. Defaults are 10
# MyUSDC and 0.0001 MyWBTC — equal value at the seeded opening price, and about
# 0.1% of the seeded liquidity. Change both together if you change the pool's
# depth, or one direction moves the price further than the other.
# SEED_BASE_USDC=10000000
# SEED_BASE_WBTC=10000

# BIP-39 mnemonic the seed wallets derive from. REQUIRED — seed-traffic.sh
# refuses to run without it.
#
# It must not be Foundry's public test mnemonic. Those addresses are watched by
# sweeper bots on every public testnet: the funding transfers confirm normally
# and the wallets are empty seconds later, which then fails as "seed wallet has
# no gas" with no obvious cause. Generate a throwaway one:
#
#   cast wallet new-mnemonic
#
# Testnet gas only — but it still should be a mnemonic nobody else knows.
SEED_MNEMONIC=
