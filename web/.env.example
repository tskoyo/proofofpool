# Next.js app (frontend + API routes).
#
# Copy to `web/.env` (gitignored) and fill in. Foundry/deployment variables live
# in the ROOT .env, not here — forge does not read this file.
#
# Fill order (the address values don't exist until you deploy):
#   1. cast wallet new  -> private key here, public address in root .env
#   2. fund that address with Sepolia ETH
#   3. deploy via script/DeployPool.s.sol
#   4. paste the deployed addresses into the *_ADDRESS vars below

# =============================================================================
# SERVER-ONLY — never prefix these with NEXT_PUBLIC_, never log them.
# =============================================================================

# World ID RP signing key, from the Developer Portal. Signs proof requests so
# World knows the request came from your app. The Portal returns it exactly
# once; if it leaks, rotate it (rotate_world_id_signing_key) and redeploy —
# anyone holding it can forge proof requests as your app.
RP_SIGNING_KEY=

# The verify endpoint is keyed by rp_id, not app_id:
#   POST https://developer.world.org/api/v4/verify/{rp_id}
# Same value as NEXT_PUBLIC_WLD_RP_ID below.
WORLD_RP_ID=rp_xxxxx

# Asserted against the `action` field inside the IDKit result, so a proof minted
# for a different action can't be replayed here. Must match NEXT_PUBLIC_WLD_ACTION.
# NOTE: the API route reads WORLD_ACTION — not WORLD_ID_ACTION_ID, which is the
# Foundry name and belongs in the root .env.
WORLD_ACTION=verify

# Asserted against the `environment` field inside the IDKit result, so a
# staging/sandbox proof can't be accepted as production. Leave empty to skip the
# check — do that on a first run, then pin it to whatever the result reports.
#
# IDKit's `environment` option defaults to "production" and verify/page.tsx does
# not override it, so requests go out as production and the Portal action must
# exist in production too. Testing against staging/sandbox means passing
# `environment` to IDKitRequestWidget as well as setting this.
# One of: production | staging | sandbox
WORLD_ENVIRONMENT=

# Backend attester key. Signs and sends Registry.registerVerifiedHuman, so it
# needs Sepolia ETH for gas. Its public address MUST equal REGISTRY_ATTESTER in
# the root .env, or every registration reverts with NotAttester.
# Use a throwaway key from `cast wallet new` — never a personal wallet. A leak
# lets an attacker mark arbitrary addresses as verified humans.
ATTESTER_PRIVATE_KEY=

# Deployed Registry address (from step 3 above) and the RPC the attester route
# broadcasts through. Both optional: without them a proof is still verified
# against World and reported as `registered: false`, so the World ID flow can be
# tested before any contract exists.
REGISTRY_ADDRESS=
RPC_URL=

# =============================================================================
# CLIENT-EXPOSED — shipped to the browser. Public data only.
# =============================================================================

# Must match WORLD_APP_ID / WORLD_ACTION above.
NEXT_PUBLIC_WLD_APP_ID=app_xxxxx
NEXT_PUBLIC_WLD_ACTION=verify
NEXT_PUBLIC_WLD_RP_ID=rp_xxxxx

# Same Registry as REGISTRY_ADDRESS above. Exposed so the UI can read
# isVerifiedHuman directly — reads are public, and the attester key stays
# server-side. Unset => the UI shows "Registry not configured".
NEXT_PUBLIC_REGISTRY_ADDRESS=

# Deployed ProofPoolHook address. Unset => the swap page shows the fee tiers
# compiled into ProofPoolHook.sol instead of reading them from chain.
NEXT_PUBLIC_HOOK_ADDRESS=

# Browser-side RPC for the read-only status/fee calls. Unset => falls back to
# the chain's default public RPC, which is rate-limited. Set it for a demo.
NEXT_PUBLIC_RPC_URL=
