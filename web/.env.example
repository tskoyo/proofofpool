# Client-exposed — safe to ship to the browser.
NEXT_PUBLIC_WLD_APP_ID=app_xxxxx
NEXT_PUBLIC_WLD_ACTION=verify-human
NEXT_PUBLIC_WLD_RP_ID=rp_xxxxx

# Server-only. Never prefix these with NEXT_PUBLIC_.
WORLD_APP_ID=app_xxxxx
WORLD_ACTION=verify-human
WORLD_API_KEY=
RP_SIGNING_KEY=

# Registry contract + the backend relayer that's allowed to call
# registerVerifiedHuman on it (must match the `attester` the contract
# was deployed with — see script/DeployPool.s.sol / REGISTRY_ATTESTER).
REGISTRY_ADDRESS=0x
ATTESTER_PRIVATE_KEY=0x
RPC_URL=
