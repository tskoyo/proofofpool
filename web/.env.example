# Client-exposed — safe to ship to the browser.
NEXT_PUBLIC_WLD_APP_ID=app_xxxxx
NEXT_PUBLIC_WLD_ACTION=verify-human
NEXT_PUBLIC_WLD_RP_ID=rp_xxxxx

# Same Registry contract as REGISTRY_ADDRESS below, exposed to the browser so the
# UI can read isVerifiedHuman() for the connected wallet. Reads are public — the
# attester key is what stays server-side, not the address.
NEXT_PUBLIC_REGISTRY_ADDRESS=0x
# Optional. Falls back to the chain's default public RPC, which is rate-limited;
# set a real endpoint before a demo.
NEXT_PUBLIC_RPC_URL=

# Server-only. Never prefix these with NEXT_PUBLIC_.
WORLD_APP_ID=app_xxxxx
WORLD_ACTION=verify-human
WORLD_API_KEY=
RP_SIGNING_KEY=

# Registry contract + the backend relayer that's allowed to call
# registerVerifiedHuman on it (must match the `attester` the contract
# was deployed with — see script/DeployPool.s.sol / REGISTRY_ATTESTER).
REGISTRY_ADDRESS=0x
ATTESTER_PRIVATE_KEY=0x
RPC_URL=
